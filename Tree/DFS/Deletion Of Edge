const int N = 1e5+10;
const int MOD = 1e9+7; // Use large prime for modulo

vector<int> g[N];
int subtree_sum[N];
int val[N]; // Stores the value of each node

void dfs(int vertex, int parent) {
    subtree_sum[vertex] = val[vertex - 1]; // Use val[vertex - 1] since nodes are 1-indexed
    for(int child : g[vertex]) {
        if(child == parent) continue;
        dfs(child, vertex);
        subtree_sum[vertex] += subtree_sum[child];
    }
}

int Solution::deleteEdge(vector<int> &A, vector<vector<int>> &B) {
    int n = A.size(); // Number of nodes
    
    // Reset global variables
    for(int i = 0; i <= n; i++) {
        g[i].clear();
        subtree_sum[i] = 0;
    }

    // Store node values
    for(int i = 0; i < n; i++) {   //just copy node values 
        val[i] = A[i];
    }

    // Build the tree
    for(auto edge : B) {
        g[edge[0]].push_back(edge[1]);
        g[edge[1]].push_back(edge[0]);
    }

    // Run DFS to calculate subtree sums
    dfs(1, 0);

    // Find maximum product by virtually cutting each edge
    long long total = subtree_sum[1];
    long long ans = 0;
    for(int i = 2; i <= n; i++) {
        long long part1 = subtree_sum[i];
        long long part2 = total - part1;
        ans = max(ans, (part1 * part2) % MOD);
    }

    return (int)(ans % MOD);
}
