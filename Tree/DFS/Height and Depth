 //                                    FOr height and depth of tree 
// 1). edit before entering the child node and after exiting the child node in before entering add curent vertex + 1(depth[child] = depth[vertex] + 1) and for exiting (depth[vertex] = maximum of curr vertex [(height(vertex)) + height[child] + 1)]
const int N = 1e5;
vector<int> g[N];
int depth[N];
int height[N];

void dfs(int vertex, int par=0){
    for(int child : g[vertex]){
      
   
    if(child == par) continue;    // means we revisit 
         depth[child] = depth[vertex] + 1;
    dfs(child, vertex);
         height[vertex] = max(height[vertex] , height[child] + 1);
    }
}
int main(){
    int n; // vertexes and edges 
    cin >> n;

    // no. of the edges no. of times 
    for(int i = 0; i< n-1; i++){
        int v1, v2;
        cin >> v1 >> v2;
        g[v1].push_back(v2);
        g[v2].push_back(v1);
    }
    dfs(1,0);  // default value is 0 for parent 
    for(int i =0; i<= n; i++){
        cout << depth[i] <<  "" << height[i] << endl;
    }
}