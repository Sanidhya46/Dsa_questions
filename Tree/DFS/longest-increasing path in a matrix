//                                        Dfs + memoization  -- 
// we imagine we stand on the last element of longest length
//  1). check bound condition -- move in all four condition and call dfs in next element only if it is smaller then the current and do maximum of all of them ... also do memoization 
//        base case + memoization + call dfs in four direction + maximum 

#include<bits/stdc++.h>
using namespace std;
class Solution {
public:
    int solve(int i,int j,int &m,int &n,vector<vector<int>> &dp,vector<vector<int>> &v){
        if(i<0||j<0||i>=m||j>=n)return 0;
        if(dp[i][j] != -1)return dp[i][j];
        int a = 0,b = 0,c = 0,d = 0;
        if(i+1<m&&v[i][j]>v[i+1][j]){
            a = solve(i+1,j,m,n,dp,v);
        }
        if(j+1<n&&v[i][j]>v[i][j+1]){
            b = solve(i,j+1,m,n,dp,v);
        }
        if(i-1>=0&&v[i][j]>v[i-1][j]){
            c = solve(i-1,j,m,n,dp,v);
        }
        if(j-1>=0&&v[i][j]>v[i][j-1]){
            d = solve(i,j-1,m,n,dp,v);
        }
        // +1 is for actively counting the current length ...
        return dp[i][j] = max({a,b,c,d})+1;
    }
    int longestIncreasingPath(vector<vector<int>>& v) {
        int i,j,m=v.size(),n=v[0].size(),ans = 1;
        vector<vector<int>>dp(m,vector<int>(n,-1));
        for(i = 0; i < m; i++){
            for(j = 0; j < n; j++){
                if(dp[i][j]==-1){
                    ans=max(ans,solve(i,j,m,n,dp,v));
                }
            }
        }
        return ans;
    }
};


